  input B1;
  input B2;
  output ZN;
  wire net0, net1, net2; 
  and (net0, A1, A2);
  not (net1, net0);
  or (net2, B1, B2);
  and (ZN, net1, net2);
    specify
     (A1 => ZN) = (1, 1);
     (A2 => ZN) = (1, 1);    
     (B1 => ZN) = (1, 1);
     (B2 => ZN) = (1, 1);
    if (A1===1'b0&&A2===1'b0&&B1===1'b0) (B2 => ZN)=(1, 1);
    if (A2===1'b1&&B1===1'b1&&B2===1'b0) (A1 => ZN)=(1, 1);
    if (A2===1'b1&&B1===1'b1&&B2===1'b1) (A1 => ZN)=(1, 1);
    if (A1===1'b1&&A2===1'b0&&B2===1'b0) (B1 => ZN)=(1, 1);
    if (A1===1'b1&&B1===1'b1&&B2===1'b0) (A2 => ZN)=(1, 1);
    if (A1===1'b1&&A2===1'b0&&B1===1'b0) (B2 => ZN)=(1, 1);
    if (A1===1'b1&&B1===1'b1&&B2===1'b1) (A2 => ZN)=(1, 1);
    if (A1===1'b0&&A2===1'b1&&B2===1'b0) (B1 => ZN)=(1, 1);
    if (A2===1'b1&&B1===1'b0&&B2===1'b1) (A1 => ZN)=(1, 1);
    if (A1===1'b0&&A2===1'b1&&B1===1'b0) (B2 => ZN)=(1, 1);
    if (A1===1'b1&&B1===1'b0&&B2===1'b1) (A2 => ZN)=(1, 1);
    if (A1===1'b0&&A2===1'b0&&B2===1'b0) (B1 => ZN)=(1, 1);
    endspecify
endmodule
