  input SRC_CLK ;
  input SRC_CLRN ;
  input DST_CLK ;
  input DST_CLRN ;
  output SRC_D ;
  output DST_Q ;
  input ATPG_CTL ;
  input TEST_MODE ;
  wire src_sel,dst_sel;
  reg  SRC_D_f;
  assign src_sel = SRC_D_NEXT;
  always @(posedge SRC_CLK or negedge SRC_CLRN)
  begin
    if(!SRC_CLRN)
      SRC_D_f <= 1'b0;
    else
      SRC_D_f <= src_sel;
  end
  assign SRC_D = SRC_D_f;
  assign dst_sel = SRC_D_f;
GEN_SYNC3C_D1 sync3d(.clk (DST_CLK),.d (dst_sel), .clr_ (DST_CLRN)	,.q(DST_Q));
endmodule
