module GEN_DFCLR_D1 (D,CP,CDN,Q);
  input D;
  input CP;
  input CDN;
  output Q;
  reg Q;
  always @(posedge CP or negedge CDN)
   begin
    if(~CDN)
        Q <= 1'b0;
    else 
        Q <= D;
   end
  specify
    (posedge CP => (Q +: D))=(1, 1);
    (negedge CDN => (Q +: 1'b0))=(1, 1);
  endspecify
endmodule
