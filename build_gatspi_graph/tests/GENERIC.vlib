module GEN_LATCH_D1 (D,E,Q);
  input D;
  input E;
  output Q;
reg Q;
  always @ (E or D)
   if (E)
    Q <= D ; 
  specify
    (D => Q)=(1, 1);
    (posedge E => (Q +: D))=(1, 1);
  endspecify
endmodule
