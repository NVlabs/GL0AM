    if (I1===1'b1&&S===1'b0) (I0 => Z)=(1, 1);
    if (I0===1'b0&&S===1'b1) (I1 => Z)=(1, 1);
    if (I0===1'b1&&S===1'b1) (I1 => Z)=(1, 1);
  endspecify
