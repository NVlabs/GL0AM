module GEN_SCAN_DFCLR_D1 (SI,D,SE,CP,CDN,Q);
  input SI;
  input D;
  input SE;
  input CP;
  input CDN;
  output Q;
reg Q;
assign sel = SE ? SI : D;
always @(posedge CP or negedge CDN)
begin
    if(~CDN)
        Q <= 1'b0;
    else 
        Q <= sel;
end
  specify
    (posedge CP => (Q +: D))=(1, 1);
    (negedge CDN => (Q +: 1'b0))=(1, 1);
  endspecify
endmodule
