module GEN_MUX3_D1 (I0,I1,I2,S0,S1,Z);
  input I0;
  input I1;
  input I2;
  input S0;
  input S1;
  output Z;
  wire net0; 
  udp_mux2 udpI0 (net0, I0, I1, S0);
  udp_mux2 udpI1 (Z, net0, I2, S1);
  specify
     (I0 => Z) = (1, 1);
     (I1 => Z) = (1, 1);
     (I2 => Z) = (1, 1);
     if (I0 === 1'b0 && I1 === 1'b1 && I2 === 1'b0 && S1 === 1'b0)     (S0 => Z) = (1, 1);
     if (I0 === 1'b1 && I1 === 1'b0 && I2 === 1'b0 && S1 === 1'b0)     (S0 => Z) = (1, 1);
     (S0 => Z) = (1, 1);
     if (I0 === 1'b0 && I1 === 1'b0 && I2 === 1'b1 && S0 === 1'b0)     (S1 => Z) = (1, 1);
     if (I0 === 1'b0 && I1 === 1'b0 && I2 === 1'b1 && S0 === 1'b1)     (S1 => Z) = (1, 1);
     if (I0 === 1'b0 && I1 === 1'b1 && I2 === 1'b0 && S0 === 1'b1)     (S1 => Z) = (1, 1);
     if (I0 === 1'b0 && I1 === 1'b1 && I2 === 1'b1 && S0 === 1'b0)     (S1 => Z) = (1, 1);
     if (I0 === 1'b1 && I1 === 1'b0 && I2 === 1'b0 && S0 === 1'b0)     (S1 => Z) = (1, 1);
     if (I0 === 1'b1 && I1 === 1'b0 && I2 === 1'b1 && S0 === 1'b1)     (S1 => Z) = (1, 1);
     if (I0 === 1'b1 && I1 === 1'b1 && I2 === 1'b0 && S0 === 1'b0)     (S1 => Z) = (1, 1);
     if (I0 === 1'b1 && I1 === 1'b1 && I2 === 1'b0 && S0 === 1'b1)     (S1 => Z) = (1, 1);
     (S1 => Z) = (1, 1);
   endspecify
endmodule
module GEN_MUX3_D2 (I0,I1,I2,S0,S1,Z);
  input I0;
  input I1;
  input I2;
  input S0;
  input S1;
  output Z;
