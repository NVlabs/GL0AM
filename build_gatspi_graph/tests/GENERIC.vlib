module GEN_AO211_D1 (A1,A2,B,C,Z);
  input A1;
  input A2;
  input B;
  input C;
  output Z;
  wire net0; 
  and (net0, A1, A2);
  or (Z, net0, B, C);
  specify
     (A1 => Z) = (1, 1);
     (A2 => Z) = (1, 1);
     (B => Z) = (1, 1);
     (C => Z) = (1, 1);
    if (A1===1'b0&&A2===1'b1&&B===1'b0) (C => Z)=(1, 1);
    if (A1===1'b1&&A2===1'b0&&C===1'b0) (B => Z)=(1, 1);
