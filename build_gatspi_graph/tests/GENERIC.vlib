module GEN_MUX2_D1 (I0,I1,S,Z);
  input I0;
  input I1;
  input S;
  output Z;
  udp_mux2 udpI0 (Z, I0, I1, S);
  specify
    (posedge S => Z)=(1, 1);
    (negedge S => Z)=(1, 1);
    (I0 => Z) = (1, 1);
    (I1 => Z) = (1, 1);
    if (I1===1'b0&&S===1'b0) (I0 => Z)=(1, 1);
    if (I1===1'b1&&S===1'b0) (I0 => Z)=(1, 1);
    if (I0===1'b0&&S===1'b1) (I1 => Z)=(1, 1);
    if (I0===1'b1&&S===1'b1) (I1 => Z)=(1, 1);
  endspecify
endmodule
