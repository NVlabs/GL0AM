module GEN_MUX2N_D1 (I0,I1,S,ZN);
  input I0;
  input I1;
  input S;
  output ZN;
  wire Z; 
  udp_mux2 udpI0 (Z, I0, I1, S);
  not (ZN, Z);
      specify
        (posedge S => ZN) = (1, 1);
