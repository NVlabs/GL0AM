`timescale 1ps/1ps
primitive udp_mux2 (Z, I0, I1, s);
   output Z;
   input  I0, I1, s;
   table
// I0 I1 s :  Z
    1  ?  0 :  1;
    0  ?  0 :  0;
    ?  1  1 :  1;
    ?  0  1 :  0;
    0  0  x :  0;
    1  1  x :  1;
   endtable
endprimitive

